# 이 파일을 .env로 복사한 뒤 값을 채운다. 셋 다 선택 사항이다.
# cp .env.example .env

# OpenAI 호환 엔드포인트
# 로컬 Ollama:  http://localhost:11434/v1
# vLLM:         http://<host>:8000/v1
# LM Studio:    http://localhost:1234/v1
# OpenAI:       https://api.openai.com/v1
OPENAI_BASE_URL=

# 모델 이름 (엔드포인트가 제공하는 이름 그대로)
OPENAI_MODEL=

# 인증이 필요한 서버에서만 지정한다. 비워 두면 자리 표시자가 들어간다.
OPENAI_API_KEY=

# researcher가 조사할 로컬 디렉터리 (기본값: 현재 디렉터리)
DOCS_ROOT=

# coder가 파일을 고치고 명령을 실행할 작업 디렉터리 (기본값: 현재 디렉터리)
WORKSPACE_ROOT=
