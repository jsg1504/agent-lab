# 이 파일을 .env로 복사한 뒤 값을 채운다. OPENAI_BASE_URL과 OPENAI_MODEL은 필수다.
# cp .env.example .env

# (필수) OpenAI 호환 엔드포인트
# 로컬 서버(vLLM, llama.cpp, LM Studio, Ollama 등):  http://<host>:<port>/v1
# 호스팅 API:                                       https://api.example.com/v1
OPENAI_BASE_URL=

# (필수) 모델 이름 (엔드포인트가 제공하는 이름 그대로)
OPENAI_MODEL=

# 인증이 필요한 서버에서만 지정한다. 비워 두면 자리 표시자가 들어간다.
OPENAI_API_KEY=

# researcher가 조사할 로컬 디렉터리 (기본값: 현재 디렉터리)
# 벤치마크 명령은 이 값이 프로젝트나 WORKSPACE_ROOT와 겹치면 쓰지 않는다. 참고 자료를 주려면 겹치지 않는 디렉터리를 지정한다.
DOCS_ROOT=

# (npu-researcher 명령에만 필요) NPU wiki 디렉터리. 마크다운 페이지에 frontmatter(id, title, tags, aliases, confidence)를 단다.
NPU_WIKI_ROOT=

# coder가 파일을 고치고 명령을 실행할 작업 디렉터리 (기본값: 프로젝트 안의 workspace/. 없으면 만든다)
WORKSPACE_ROOT=

# evaluator가 측정을 돌릴 파이썬. torch가 설치된 인터프리터를 가리켜야 한다.
# uv venv 안의 python에는 torch가 없으므로 보통 따로 지정해야 한다.
BENCH_PYTHON=

# (kernelbench 명령에만 필요) KernelBench 저장소 경로. 예: ~/KernelBench
KERNELBENCH_ROOT=

# KernelBench 채점을 돌릴 파이썬. KernelBench와 torch가 설치돼 있어야 한다. 비우면 BENCH_PYTHON을 쓴다.
KERNELBENCH_PYTHON=

# (flashinferbench 명령에만 필요) FlashInfer-Bench 데이터셋 디렉터리(definitions/, workloads/가 있는 곳).
# 예: ~/flashinfer-bench/flashinfer_trace
FLASHINFER_TRACE_ROOT=

# FlashInfer-Bench 채점을 돌릴 파이썬. flashinfer-bench와 torch가 설치돼 있어야 한다. 비우면 BENCH_PYTHON을 쓴다.
FLASHINFER_BENCH_PYTHON=

# 추적 로그(질문과 답, LLM 요청/응답 원문, 토큰). 기본으로 켜져 있고 0이면 끈다.
TRACE=

# 추적 로그를 남길 디렉터리 (기본값: 프로젝트 안의 traces/. 없으면 만든다)
TRACE_DIR=
